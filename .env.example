# Copy to .env and fill in.
DATABASE_URL=sqlite:///./pricewatch.db

# How often to check prices, in minutes.
CHECK_INTERVAL_MINUTES=360

# Telegram alerts. Create a bot with @BotFather, then message it and read
# your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Set to 1 to return randomised prices instead of hitting real sites.
# Useful for demos and development.
MOCK_SCRAPER=0

# Polite delay between products during a scheduled run, in seconds.
SCRAPE_DELAY_SECONDS=3
