# Copy to .env
# Simulated results for demos / offline development (1 = on)
MOCK_STORES=0
# Re-use results for the same query for this long
CACHE_TTL_MINUTES=180
# Max results taken from each store
RESULTS_PER_STORE=12
DATABASE_PATH=./pricecompare.db
# Optional: route Amazon/Flipkart/Snapdeal through a residential proxy when hosted on a cloud
# (stores block datacenter IPs). Get a free key at https://www.scraperapi.com
SCRAPER_API_KEY=
# Or any HTTP proxy URL instead: http://user:pass@host:port
SCRAPER_PROXY_URL=

# Price-drop alerts: the checker runs daily via Vercel Cron, or `make alerts`. Protect the
# /api/alerts/run endpoint with a secret (Vercel sends it automatically as a Bearer token).
CRON_SECRET=
# Email delivery for alerts (leave SMTP_HOST empty to record alerts without sending email).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
# Public URL used in alert emails
APP_URL=http://localhost:8000
